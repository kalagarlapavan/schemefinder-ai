{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "schemefinder-ai-backend": {
      "root": "backend/",
      "entrypoint": "app.main:app",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "schemefinder-ai-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
